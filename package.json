{
  "name": "youtube-ai-summarizer",
  "version": "1.3.1",
  "description": "Chrome/Brave Extension to summarize YouTube videos and chat with transcripts using local AI (LM Studio, Ollama) or Cloud AI (Gemini, Groq, OpenAI).",
  "main": "dist/background.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test --experimental-test-coverage tests/*.test.js",
    "coverage": "node scripts/ci_reporter.js",
    "check": "node --check dist/content.js dist/background.js dist/main_world.js dist/popup.js",
    "package": "node scripts/package.js",
    "candidate:start": "node scripts/git_workflow.js start",
    "candidate:status": "node scripts/git_workflow.js status",
    "candidate:finish": "node scripts/git_workflow.js finish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hidr4c/youtube-ai-summarizer.git"
  },
  "keywords": [
    "chrome-extension",
    "youtube",
    "ai",
    "summarizer",
    "lm-studio",
    "ollama",
    "whisper",
    "groq",
    "gemini",
    "openai",
    "qwen",
    "speech-to-text",
    "text-to-speech"
  ],
  "author": "Hidr4c (https://github.com/Hidr4c)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Hidr4c/youtube-ai-summarizer/issues"
  },
  "homepage": "https://github.com/Hidr4c/youtube-ai-summarizer#readme",
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
